{
  "name": "boxbox",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": { "node": ">=18" },
  "type": "module",
  "description": "BoxBox — isolated accounts per tab for Firefox and Chrome",
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node tests/unit.mjs && node tests/run.mjs",
    "fixture": "node fixture/server.mjs",
    "launch:firefox": "node scripts/launch.mjs firefox",
    "launch:chrome": "node scripts/launch.mjs chrome",
    "launch:helium": "node scripts/launch.mjs helium",
    "test:firefox": "node tests/run.mjs --browser firefox",
    "test:chrome": "node tests/run.mjs --browser chrome",
    "test:helium": "node tests/run.mjs --browser helium",
    "smoke": "node tests/smoke.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:e2e": "node tests/run.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.15.0",
    "selenium-webdriver": "^4.51.0",
    "simple-icons": "^16.35.0",
    "tldts": "^7.4.19",
    "ws": "^8.22.0"
  }
}
